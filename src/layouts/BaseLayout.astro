---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';

interface Props {
  title: string;
  description?: string;
  /** Social-share image path; defaults to the site-wide card. */
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Interactive learning center for LLM and transformer internals.',
  image,
  type = 'website',
} = Astro.props;
const fullTitle = title === 'LLM Internals' ? title : `${title} · LLM Internals`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <SocialMeta title={fullTitle} description={description} image={image} type={type} />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen bg-ink-900">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
